KIRA: Str = "..\\vendor\\kira\\build\\install\\kira\\bin\\kira.bat"
PY: Str = ".venv\\Scripts\\python.exe"

pub Mutant: Any {
    pub file: Str
    pub old: Str
    pub new: Str
    pub why: Str
}

MUTANTS: List<Mutant> = @listOf(
    Mutant { "frame.kira", "CRC_POLY: UInt32 = 0x82F63B78", "CRC_POLY: UInt32 = 0xEDB88320", "the CRC polynomial is the wrong one" },
    Mutant { "frame.kira", "if payload.size() > MAX_PAYLOAD || payload.size() % 4 != 0 {", "if payload.size() % 4 != 0 {", "encode accepts oversized payloads" },
    Mutant { "frame.kira", "if payload.size() > MAX_PAYLOAD || payload.size() % 4 != 0 {", "if payload.size() > MAX_PAYLOAD {", "encode accepts a payload that is not a multiple of 4" },
    Mutant { "frame.kira", "crc32c(out, out.size())", "crc32c(out, out.size() - 1)", "the CRC covers one byte too few" },
    Mutant { "frame.kira", "(bytes[0] as Int32) != MAGIC_LO || (bytes[1] as Int32) != MAGIC_HI", "(bytes[0] as Int32) != MAGIC_LO", "check ignores the second magic byte" },
    Mutant { "frame.kira", "len % 4 != 0 || len > MAX_PAYLOAD ? BAD_LENGTH", "len % 4 != 0 ? BAD_LENGTH", "check accepts an oversized length" },
    Mutant { "frame.kira", "n != HEADER_BYTES + len + TRAILER_BYTES ? BAD_LENGTH", "n < HEADER_BYTES + len + TRAILER_BYTES ? BAD_LENGTH", "check accepts trailing bytes" },
    Mutant { "frame.kira", "littleEndian(bytes, n - TRAILER_BYTES, 4) ? BAD_CRC", "littleEndian(bytes, n - TRAILER_BYTES, 3) ? BAD_CRC", "check compares a truncated CRC" },
    Mutant { "frame.kira", "littleEndian(bytes, 6, 2) as Int32, payload", "littleEndian(bytes, 6, 1) as Int32, payload", "decode reads a one-byte sequence" },
    Mutant { "frame.kira", "v = v + ((data[at + i] as Int64) << (8 * i))", "v = v + ((data[at + i] as Int64) << (8 * (i + 1)))", "little-endian reads shift the wrong way" },
    Mutant { "frame.kira", "last < 0 || ((seq - last + 65536) % 65536 > 0 && (seq - last + 65536) % 65536 < 32768)", "last < 0 || ((seq - last + 65536) % 65536 > 0 && (seq - last + 65536) % 65536 <= 32768)", "the half-window boundary is off by one" },
    Mutant { "link.kira", "if len % 4 != 0 || len > MAX_PAYLOAD {", "if len % 4 != 0 {", "the receiver accepts an oversized length" },
    Mutant { "link.kira", "} else if (held[1] as Int32) != MAGIC_HI {", "} else if false {", "the receiver ignores the second magic byte" },
    Mutant { "link.kira", "} else if held.size() == 1 {", "} else if held.size() == 0 {", "the receiver checks the magic before it has a byte" },
    Mutant { "telemetry.kira", "if f.kind != KIND_TELEMETRY || f.payload.size() != 16 {", "if f.kind != KIND_TELEMETRY {", "decode accepts telemetry of the wrong size" },
    Mutant { "telemetry.kira", "littleEndian(f.payload, 8, 4) - TEMP_BIAS", "littleEndian(f.payload, 8, 4)", "temperature is not un-biased" },
    Mutant { "telemetry.kira", "leBytes(t.rssiDbm + RSSI_BIAS, 4)", "leBytes(t.rssiDbm, 4)", "signal is not biased on encode" },
    Mutant { "telemetry.kira", "encode(KIND_TELEMETRY, 1, seq, body)", "encode(KIND_TELEMETRY, 2, seq, body)", "telemetry is framed as version 2" },
    Mutant { "selftest.kira", "failures.size() == 0", "true", "a FAIL line does not make a report not ok" },
    Mutant { "selftest.kira", "if parts.size() == 2 {", "if parts.size() == 1 {", "a malformed summary is read anyway" },
    Mutant { "selftest.kira", "r.total = parts[1].toInt64().unwrapOr(-1) as Int32", "r.total = parts[0].toInt64().unwrapOr(-1) as Int32", "the total is the passed count" },
    Mutant { "ina226.kira", "raw >= 32768 ? raw - 65536 : raw", "raw > 32768 ? raw - 65536 : raw", "the sign boundary is off by one" },
    Mutant { "ina226.kira", "shuntUv / rshuntMilliohm", "shuntUv * rshuntMilliohm", "current divides by the wrong thing" },
    Mutant { "ina226.kira", "(5120000.0 / (lsbMicroamps * rshuntMilliohm))", "(5120000.0 / lsbMicroamps)", "calibration ignores the shunt" },
    Mutant { "ina226.kira", "raw.toFloat64() * 1.25", "raw.toFloat64() * 1.5", "bus voltage uses the wrong LSB" },
    Mutant { "sensors.kira", "(raw >= 32768 ? raw - 65536 : raw).toFloat64() / 16.0", "(raw >= 32768 ? raw - 65536 : raw).toFloat64() / 8.0", "the probe scale is doubled" },
    Mutant { "sensors.kira", "raw >= 32768 ? raw - 65536 : raw", "raw > 32768 ? raw - 65536 : raw", "the probe sign boundary is off by one" },
    Mutant { "ring.kira", "if held.size() >= cap as Size {", "if held.size() > cap as Size {", "the ring grows past its capacity" },
    Mutant { "ring.kira", "held.removeAt(0)", "held.removeAt(held.size() - 1)", "the ring drops the newest instead of the oldest" },
    Mutant { "lines.kira", "if b != CR && held.size() < cap {", "if b != CR {", "a line is not cut at its cap" },
    Mutant { "debounce.kira", "if streak >= need {", "if streak > need {", "a press needs one reading too many" },
    Mutant { "command.kira", "n + 1 < parts.size() ? parts[n + 1] : null", "n < parts.size() ? parts[n + 1] : null", "an argument past the last is read" },
    Mutant { "bridge.kira", "faulted: Bool = mode != PASS && seen % every == 0", "faulted: Bool = mode != PASS && seen % every == 1", "the bridge faults the wrong frames" },
    Mutant { "bridge.kira", "dropping: Bool = faulted && mode == DROP", "dropping: Bool = faulted && mode == CORRUPT", "the drop and corrupt modes are swapped" },
    Mutant { "bridge.kira", "dropping: Bool = faulted && mode == DROP", "dropping: Bool = faulted && mode == DROP && false", "the drop mode never drops" },
    Mutant { "bridge.kira", "flip: Int32 = flipping && i == wire.size() - 1 ? 0x5A : 0", "flip: Int32 = flipping && i == wire.size() - 1 ? 0x00 : 0", "the corrupt mode changes nothing" },
    Mutant { "bridge.kira", "seen += 1", "seen += 2", "the frame count skips every other frame" },
    Mutant { "bridge.kira", "if !got.isNull() {", "if !got.isNull() && false {", "the bridge forwards nothing" }
)

runProgram: (argv: List<Str>) Int32 {
    p: Maybe<Process> = spawnProcess(argv)
    p.isNull() ? 127 : p.value.wait()
}

runQuiet: (line: Str) Int32 {
    runProgram(@listOf("cmd", "/c", "${line} > %TEMP%\\espmon-run.txt 2>&1"))
}

compileTests: () Int32 {
    runQuiet("cd /d tests && ${KIRA} --target py")
}

checkTests: () Str {
    compileTests() != 0 ? "not viable" : runQuiet("${PY} tests\\esp32_test_kira.py") != 0 ? "killed" : "passes"
}

pub main: () Int32 {
    all: List<Str> = args()
    filt: Str = all.size() > 1 ? all[1] : ""
    if checkTests() != "passes" {
        println("baseline does not pass; no mutant run")
        2
    } else {
        killed: Mutable<Int32> = 0
        notViable: Mutable<Int32> = 0
        stale: Mutable<Int32> = 0
        survived: Mutable<List<Str>> { }
        chosen: Mutable<Int32> = 0
        for m: Mutant in MUTANTS {
            if m.file.contains(filt) {
                chosen += 1
                path: Str = "esp32/src/" + m.file
                original: Str = readText(path).value
                if original.split(m.old).size() != 2 {
                    stale += 1
                    println("STALE      ${m.file}: ${m.why}")
                } else {
                    writeFile(path, original.replace(m.old, m.new).bytes())
                    result: Str = checkTests()
                    writeFile(path, original.bytes())
                    if result == "killed" {
                        killed += 1
                    } else if result == "not viable" {
                        notViable += 1
                        println("NOT VIABLE ${m.file}: ${m.why}")
                    } else {
                        survived.add("${m.file}: ${m.why}")
                    }
                }
            }
        }
        compileTests()
        println("killed ${killed}, survived ${survived.size()}, not viable ${notViable}, stale ${stale}, of ${chosen}")
        for s: Str in survived {
            println("SURVIVED   ${s}")
        }
        survived.size() == 0 && stale == 0 ? 0 : 1
    }
}
