kira.io as io
kira.test as test
esp32.command as command
esp32.command.Command as Command
esp32.debounce.Debounce as Debounce
esp32.lines.LineBuffer as LineBuffer
esp32.frame.Frame as Frame
esp32.frame.Newest as Newest
esp32.frame.encode as encode
esp32.frame.decode as decode
esp32.frame.check as check
esp32.frame.crc32c as crc32c
esp32.frame.OK as OK
esp32.frame.SHORT as SHORT
esp32.frame.BAD_MAGIC as BAD_MAGIC
esp32.frame.BAD_LENGTH as BAD_LENGTH
esp32.frame.BAD_CRC as BAD_CRC
esp32.link.Receiver as Receiver

// esp32_test: the library's line buffer, debounce and command parser.

feed: (t: Suite, buf: LineBuffer, text: Str) Maybe<Str> {
    got: Mutable<Maybe<Str>> = null
    data: List<UInt8> = text.bytes()
    for i: Size in 0..data.size() {
        r: Maybe<Str> = buf.push(data[i])
        if !r.isNull() {
            got = r
        }
    }
    got
}

linesAreCutAtTheNewline: (t: Suite) Void {
    buf: LineBuffer { 64 }
    t.check(feed(t, buf, "hel").isNull(), "no line before the newline")
    t.checkStr(feed(t, buf, "lo\r\n").value, "hello", "the line, its CR dropped")
    t.checkStr(feed(t, buf, "\n").value, "", "an empty line")
}

aLongLineIsCut: (t: Suite) Void {
    buf: LineBuffer { 4 }
    t.checkStr(feed(t, buf, "abcdefgh\n").value, "abcd", "cut at the cap")
    t.checkStr(feed(t, buf, "xy\n").value, "xy", "the next line starts clean")
}

aPressNeedsItsStreak: (t: Suite) Void {
    d: Debounce { 3 }
    t.check(!d.step(true), "one reading is not a press")
    t.check(!d.step(true), "two are not")
    t.check(d.step(true), "three are")
    t.check(d.step(false), "one release reading keeps it down")
    t.check(d.step(true), "a bounce resets the release streak")
    t.check(d.step(false) && d.step(false), "two releases keep it down")
    t.check(!d.step(false), "three release it")
}

noiseNeverPresses: (t: Suite) Void {
    d: Debounce { 2 }
    pressed: Mutable<Bool> = false
    for i: Size in 0..20 {
        if d.step(i % 2 == 0) {
            pressed = true
        }
    }
    t.check(!pressed, "an alternating reading never holds")
}

commandsAreSplit: (t: Suite) Void {
    c: Command { "  LED on  3 " }
    t.checkStr(c.verb(), "led", "the verb is lower case")
    t.check(c.count() == 2, "two arguments")
    t.checkStr(c.arg(0).value, "on", "the first argument as typed")
    t.checkStr(c.arg(1).value, "3", "the second")
    t.check(c.arg(2).isNull(), "none past the last")
    e: Command { "   " }
    t.checkStr(e.verb(), "", "a blank line has no verb")
    t.check(e.count() == 0, "and no arguments")
}

crcMatchesTheStandardCheckValue: (t: Suite) Void {
    // CRC-32C of "123456789" is 0xE3069283, the value every CRC-32C implementation is checked against.
    t.check(crc32c("123456789".bytes(), 9) as Int64 == 3808858755, "CRC-32C of 123456789")
    t.check(crc32c(List<UInt8> { }, 0) as Int64 == 0, "CRC-32C of nothing is 0")
}

aFrameRoundTrips: (t: Suite) Void {
    payload: List<UInt8> = "abcdefgh".bytes()
    bytes: Maybe<List<UInt8>> = encode(3, 1, 7, payload)
    t.check(!bytes.isNull(), "an 8-byte payload encodes")
    t.check(bytes.value.size() == 24, "12 header, 8 payload, 4 CRC")
    t.check(check(bytes.value) == OK, "its own bytes check")
    got: Maybe<Frame> = decode(bytes.value)
    t.check(!got.isNull(), "and decodes")
    t.check(got.value.kind == 3 && got.value.ver == 1 && got.value.seq == 7, "kind, version and seq come back")
    t.checkStr(Str.of(got.value.payload.view()), "abcdefgh", "the payload comes back")
}

aSeqWrapsInTwoBytes: (t: Suite) Void {
    bytes: Maybe<List<UInt8>> = encode(1, 1, 65537, List<UInt8> { })
    got: Maybe<Frame> = decode(bytes.value)
    t.check(got.value.seq == 1, "a seq past 65535 wraps")
}

aBadPayloadIsRefused: (t: Suite) Void {
    t.check(encode(1, 1, 0, "abcdef".bytes()).isNull(), "a payload not a multiple of 4 is refused")
    big: Mutable<List<UInt8>> { }
    for i: Size in 0..1028 {
        big.add(0)
    }
    t.check(encode(1, 1, 0, big).isNull(), "a payload past MAX_PAYLOAD is refused")
}

aFlippedByteFailsTheCrc: (t: Suite) Void {
    good: List<UInt8> = encode(2, 1, 1, "abcdefgh".bytes()).value
    bad: Mutable<List<UInt8>> { }
    for i: Size in 0..good.size() {
        bad.add(good[i])
    }
    bad.set(14, bad[14] + 1)
    t.check(check(bad) == BAD_CRC, "one flipped payload byte is a CRC failure")
    t.check(decode(bad).isNull(), "and it does not decode")
}

aMalformedFramesAreNamed: (t: Suite) Void {
    good: List<UInt8> = encode(2, 1, 1, "abcdefgh".bytes()).value
    t.check(check(good.slice(0, 10).toList()) == SHORT, "a header cut short is SHORT")
    t.check(check(good.slice(0, 20).toList()) == SHORT, "a frame cut short is SHORT")
    noMagic: Mutable<List<UInt8>> { }
    for i: Size in 0..good.size() {
        noMagic.add(good[i])
    }
    noMagic.set(0, 0)
    t.check(check(noMagic) == BAD_MAGIC, "a wrong magic is BAD_MAGIC")
    longer: Mutable<List<UInt8>> { }
    for i: Size in 0..good.size() {
        longer.add(good[i])
    }
    longer.add(0)
    t.check(check(longer) == BAD_LENGTH, "bytes past the frame are BAD_LENGTH")
}

newestWinsAndLateFramesAreDropped: (t: Suite) Void {
    n: Newest { }
    t.check(n.accept(5), "the first frame is newest")
    t.check(!n.accept(3), "an older frame is dropped")
    t.check(!n.accept(5), "a repeat is dropped")
    t.check(n.accept(6), "the next one is newer")
    t.check(!n.accept(0), "0 is 65530 behind 6, so it is stale, not a wrap")
    w: Newest { }
    t.check(w.accept(65534), "a counter starts near the top")
    t.check(w.accept(65535), "and climbs")
    t.check(w.accept(0), "0 after 65535 is a wrap, so newer")
    t.check(!w.accept(65535), "65535 is now behind 0")
}

// Every frame the receiver completes from data, in order.
receiveAll: (r: Receiver, data: List<UInt8>) List<Frame> {
    got: Mutable<List<Frame>> { }
    for i: Size in 0..data.size() {
        f: Maybe<Frame> = r.push(data[i])
        if !f.isNull() {
            got.add(f.value)
        }
    }
    got
}

aFrameArrivesByteByByte: (t: Suite) Void {
    r: Receiver { }
    got: List<Frame> = receiveAll(r, encode(2, 1, 9, "abcdefgh".bytes()).value)
    t.check(got.size() == 1, "one frame, completed by its last byte")
    t.check(got.size() == 1 && got[0].seq == 9 && got[0].kind == 2, "and it is the frame sent")
}

noiseBeforeAFrameIsSkipped: (t: Suite) Void {
    r: Receiver { }
    data: Mutable<List<UInt8>> = "junkBbytes".bytes()
    for b: UInt8 in encode(1, 1, 3, "wxyz".bytes()).value {
        data.add(b)
    }
    got: List<Frame> = receiveAll(r, data)
    t.check(got.size() == 1 && got[0].seq == 3, "the frame after noise comes out")
}

aCorruptFrameIsDroppedAndTheNextOneArrives: (t: Suite) Void {
    r: Receiver { }
    bad: Mutable<List<UInt8>> { }
    for b: UInt8 in encode(1, 1, 4, "aaaa".bytes()).value {
        bad.add(b)
    }
    bad.set(13, bad[13] + 1)
    data: Mutable<List<UInt8>> { }
    for b: UInt8 in bad {
        data.add(b)
    }
    for b: UInt8 in encode(1, 1, 5, "bbbb".bytes()).value {
        data.add(b)
    }
    got: List<Frame> = receiveAll(r, data)
    t.check(got.size() == 1, "the corrupt frame is not emitted")
    t.check(got.size() == 1 && got[0].seq == 5, "the good frame after it is")
}

backToBackFramesAreBothEmitted: (t: Suite) Void {
    r: Receiver { }
    data: Mutable<List<UInt8>> { }
    for b: UInt8 in encode(1, 1, 10, "aaaa".bytes()).value {
        data.add(b)
    }
    for b: UInt8 in encode(1, 1, 11, "bbbb".bytes()).value {
        data.add(b)
    }
    got: List<Frame> = receiveAll(r, data)
    t.check(got.size() == 2, "two frames back to back are both emitted")
    t.check(got.size() == 2 && got[0].seq == 10 && got[1].seq == 11, "in order")
}

aBogusLengthDoesNotStallTheStream: (t: Suite) Void {
    r: Receiver { }
    // "BW", kind 1, version 1, flags 0, seq 0, then a length of 3, which is not a multiple of 4.
    bogus: Mutable<List<UInt8>> = @listOf(0x42, 0x57, 1, 1, 0, 0, 0, 0, 3, 0, 0, 0)
    data: Mutable<List<UInt8>> { }
    for b: UInt8 in bogus {
        data.add(b)
    }
    for b: UInt8 in encode(1, 1, 12, "cccc".bytes()).value {
        data.add(b)
    }
    got: List<Frame> = receiveAll(r, data)
    t.check(got.size() == 1 && got[0].seq == 12, "a header claiming 3 bytes is skipped and the frame after it arrives")
}

pub main: () Int32 {
    t: Suite { title = "esp32_test - the esp32 library (lines, debounce, command)" }
    linesAreCutAtTheNewline(t)
    aLongLineIsCut(t)
    aPressNeedsItsStreak(t)
    noiseNeverPresses(t)
    commandsAreSplit(t)
    crcMatchesTheStandardCheckValue(t)
    aFrameRoundTrips(t)
    aSeqWrapsInTwoBytes(t)
    aBadPayloadIsRefused(t)
    aFlippedByteFailsTheCrc(t)
    aMalformedFramesAreNamed(t)
    newestWinsAndLateFramesAreDropped(t)
    aFrameArrivesByteByByte(t)
    noiseBeforeAFrameIsSkipped(t)
    aCorruptFrameIsDroppedAndTheNextOneArrives(t)
    backToBackFramesAreBothEmitted(t)
    aBogusLengthDoesNotStallTheStream(t)
    t.finish()
}
