kira.io as io
kira.test as test
esp32.command as command
esp32.command.Command as Command
esp32.debounce.Debounce as Debounce
esp32.lines.LineBuffer as LineBuffer
esp32.frame.Frame as Frame
esp32.frame.Newest as Newest
esp32.frame.encode as encode
esp32.frame.decode as decode
esp32.frame.check as check
esp32.frame.crc32c as crc32c
esp32.frame.OK as OK
esp32.frame.SHORT as SHORT
esp32.frame.BAD_MAGIC as BAD_MAGIC
esp32.frame.BAD_LENGTH as BAD_LENGTH
esp32.frame.BAD_CRC as BAD_CRC
esp32.link.Receiver as Receiver
esp32.telemetry.Telemetry as Telemetry
esp32.telemetry.telemetryRow as telemetryRow
esp32.telemetry.telemetryHeader as telemetryHeader
esp32.selftest.Report as Report
esp32.telemetry.encodeTelemetry as encodeTelemetry
esp32.telemetry.decodeTelemetry as decodeTelemetry
esp32.selftest.readReport as readReport
esp32.ina226.busMillivolts as busMillivolts
esp32.ina226.shuntMicrovolts as shuntMicrovolts
esp32.ina226.currentMilliamps as currentMilliamps
esp32.ina226.calibration as calibration
esp32.sensors.ds18b20Celsius as ds18b20Celsius
esp32.ring.Ring as Ring
esp32.bridge.Bridge as Bridge
esp32.bridge.PASS as PASS
esp32.bridge.DROP as DROP
esp32.bridge.CORRUPT as CORRUPT

// esp32_test: the library's line buffer, debounce and command parser.

feed: (t: Suite, buf: LineBuffer, text: Str) Maybe<Str> {
    got: Mutable<Maybe<Str>> = null
    data: List<UInt8> = text.bytes()
    for i: Size in 0..data.size() {
        r: Maybe<Str> = buf.push(data[i])
        if !r.isNull() {
            got = r
        }
    }
    got
}

linesAreCutAtTheNewline: (t: Suite) Void {
    buf: LineBuffer { 64 }
    t.check(feed(t, buf, "hel").isNull(), "no line before the newline")
    t.checkStr(feed(t, buf, "lo\r\n").value, "hello", "the line, its CR dropped")
    t.checkStr(feed(t, buf, "\n").value, "", "an empty line")
}

aLongLineIsCut: (t: Suite) Void {
    buf: LineBuffer { 4 }
    t.checkStr(feed(t, buf, "abcdefgh\n").value, "abcd", "cut at the cap")
    t.checkStr(feed(t, buf, "xy\n").value, "xy", "the next line starts clean")
}

aPressNeedsItsStreak: (t: Suite) Void {
    d: Debounce { 3 }
    t.check(!d.step(true), "one reading is not a press")
    t.check(!d.step(true), "two are not")
    t.check(d.step(true), "three are")
    t.check(d.step(false), "one release reading keeps it down")
    t.check(d.step(true), "a bounce resets the release streak")
    t.check(d.step(false) && d.step(false), "two releases keep it down")
    t.check(!d.step(false), "three release it")
}

noiseNeverPresses: (t: Suite) Void {
    d: Debounce { 2 }
    pressed: Mutable<Bool> = false
    for i: Size in 0..20 {
        if d.step(i % 2 == 0) {
            pressed = true
        }
    }
    t.check(!pressed, "an alternating reading never holds")
}

commandsAreSplit: (t: Suite) Void {
    c: Command { "  LED on  3 " }
    t.checkStr(c.verb(), "led", "the verb is lower case")
    t.check(c.count() == 2, "two arguments")
    t.checkStr(c.arg(0).value, "on", "the first argument as typed")
    t.checkStr(c.arg(1).value, "3", "the second")
    t.check(c.arg(2).isNull(), "none past the last")
    e: Command { "   " }
    t.checkStr(e.verb(), "", "a blank line has no verb")
    t.check(e.count() == 0, "and no arguments")
}

crcMatchesTheStandardCheckValue: (t: Suite) Void {
    // CRC-32C of "123456789" is 0xE3069283, the value every CRC-32C implementation is checked against.
    t.check(crc32c("123456789".bytes(), 9) as Int64 == 3808858755, "CRC-32C of 123456789")
    t.check(crc32c(List<UInt8> { }, 0) as Int64 == 0, "CRC-32C of nothing is 0")
}

aFrameRoundTrips: (t: Suite) Void {
    payload: List<UInt8> = "abcdefgh".bytes()
    bytes: Maybe<List<UInt8>> = encode(3, 1, 7, payload)
    t.check(!bytes.isNull(), "an 8-byte payload encodes")
    t.check(bytes.value.size() == 24, "12 header, 8 payload, 4 CRC")
    t.check(check(bytes.value) == OK, "its own bytes check")
    got: Maybe<Frame> = decode(bytes.value)
    t.check(!got.isNull(), "and decodes")
    t.check(got.value.kind == 3 && got.value.ver == 1 && got.value.seq == 7, "kind, version and seq come back")
    t.checkStr(Str.of(got.value.payload.view()), "abcdefgh", "the payload comes back")
}

aSeqWrapsInTwoBytes: (t: Suite) Void {
    bytes: Maybe<List<UInt8>> = encode(1, 1, 65537, List<UInt8> { })
    got: Maybe<Frame> = decode(bytes.value)
    t.check(got.value.seq == 1, "a seq past 65535 wraps")
}

aBadPayloadIsRefused: (t: Suite) Void {
    t.check(encode(1, 1, 0, "abcdef".bytes()).isNull(), "a payload not a multiple of 4 is refused")
    big: Mutable<List<UInt8>> { }
    for i: Size in 0..1028 {
        big.add(0)
    }
    t.check(encode(1, 1, 0, big).isNull(), "a payload past MAX_PAYLOAD is refused")
}

aFlippedByteFailsTheCrc: (t: Suite) Void {
    good: List<UInt8> = encode(2, 1, 1, "abcdefgh".bytes()).value
    bad: Mutable<List<UInt8>> { }
    for i: Size in 0..good.size() {
        bad.add(good[i])
    }
    bad.set(14, bad[14] + 1)
    t.check(check(bad) == BAD_CRC, "one flipped payload byte is a CRC failure")
    t.check(decode(bad).isNull(), "and it does not decode")
}

aMalformedFramesAreNamed: (t: Suite) Void {
    good: List<UInt8> = encode(2, 1, 1, "abcdefgh".bytes()).value
    t.check(check(good.slice(0, 10).toList()) == SHORT, "a header cut short is SHORT")
    t.check(check(good.slice(0, 20).toList()) == SHORT, "a frame cut short is SHORT")
    noMagic: Mutable<List<UInt8>> { }
    for i: Size in 0..good.size() {
        noMagic.add(good[i])
    }
    noMagic.set(0, 0)
    t.check(check(noMagic) == BAD_MAGIC, "a wrong magic is BAD_MAGIC")
    longer: Mutable<List<UInt8>> { }
    for i: Size in 0..good.size() {
        longer.add(good[i])
    }
    longer.add(0)
    t.check(check(longer) == BAD_LENGTH, "bytes past the frame are BAD_LENGTH")
}

newestWinsAndLateFramesAreDropped: (t: Suite) Void {
    n: Newest { }
    t.check(n.accept(5), "the first frame is newest")
    t.check(!n.accept(3), "an older frame is dropped")
    t.check(!n.accept(5), "a repeat is dropped")
    t.check(n.accept(6), "the next one is newer")
    t.check(!n.accept(0), "0 is 65530 behind 6, so it is stale, not a wrap")
    w: Newest { }
    t.check(w.accept(65534), "a counter starts near the top")
    t.check(w.accept(65535), "and climbs")
    t.check(w.accept(0), "0 after 65535 is a wrap, so newer")
    t.check(!w.accept(65535), "65535 is now behind 0")
}

// Every frame the receiver completes from data, in order.
receiveAll: (r: Receiver, data: List<UInt8>) List<Frame> {
    got: Mutable<List<Frame>> { }
    for i: Size in 0..data.size() {
        f: Maybe<Frame> = r.push(data[i])
        if !f.isNull() {
            got.add(f.value)
        }
    }
    got
}

aFrameArrivesByteByByte: (t: Suite) Void {
    r: Receiver { }
    got: List<Frame> = receiveAll(r, encode(2, 1, 9, "abcdefgh".bytes()).value)
    t.check(got.size() == 1, "one frame, completed by its last byte")
    t.check(got.size() == 1 && got[0].seq == 9 && got[0].kind == 2, "and it is the frame sent")
}

noiseBeforeAFrameIsSkipped: (t: Suite) Void {
    r: Receiver { }
    data: Mutable<List<UInt8>> = "junkBbytes".bytes()
    for b: UInt8 in encode(1, 1, 3, "wxyz".bytes()).value {
        data.add(b)
    }
    got: List<Frame> = receiveAll(r, data)
    t.check(got.size() == 1 && got[0].seq == 3, "the frame after noise comes out")
}

aCorruptFrameIsDroppedAndTheNextOneArrives: (t: Suite) Void {
    r: Receiver { }
    bad: Mutable<List<UInt8>> { }
    for b: UInt8 in encode(1, 1, 4, "aaaa".bytes()).value {
        bad.add(b)
    }
    bad.set(13, bad[13] + 1)
    data: Mutable<List<UInt8>> { }
    for b: UInt8 in bad {
        data.add(b)
    }
    for b: UInt8 in encode(1, 1, 5, "bbbb".bytes()).value {
        data.add(b)
    }
    got: List<Frame> = receiveAll(r, data)
    t.check(got.size() == 1, "the corrupt frame is not emitted")
    t.check(got.size() == 1 && got[0].seq == 5, "the good frame after it is")
}

backToBackFramesAreBothEmitted: (t: Suite) Void {
    r: Receiver { }
    data: Mutable<List<UInt8>> { }
    for b: UInt8 in encode(1, 1, 10, "aaaa".bytes()).value {
        data.add(b)
    }
    for b: UInt8 in encode(1, 1, 11, "bbbb".bytes()).value {
        data.add(b)
    }
    got: List<Frame> = receiveAll(r, data)
    t.check(got.size() == 2, "two frames back to back are both emitted")
    t.check(got.size() == 2 && got[0].seq == 10 && got[1].seq == 11, "in order")
}

aBogusLengthDoesNotStallTheStream: (t: Suite) Void {
    r: Receiver { }
    // "BW", kind 1, version 1, flags 0, seq 0, then a length of 3, which is not a multiple of 4.
    bogus: Mutable<List<UInt8>> = @listOf(0x42, 0x57, 1, 1, 0, 0, 0, 0, 3, 0, 0, 0)
    data: Mutable<List<UInt8>> { }
    for b: UInt8 in bogus {
        data.add(b)
    }
    for b: UInt8 in encode(1, 1, 12, "cccc".bytes()).value {
        data.add(b)
    }
    got: List<Frame> = receiveAll(r, data)
    t.check(got.size() == 1 && got[0].seq == 12, "a header claiming 3 bytes is skipped and the frame after it arrives")
}

telemetryRoundTrips: (t: Suite) Void {
    sent: Telemetry { 123456, 98765, -500, -60 }
    bytes: List<UInt8> = encodeTelemetry(7, sent).value
    r: Receiver { }
    got: List<Frame> = receiveAll(r, bytes)
    t.check(got.size() == 1, "one telemetry frame comes out of its bytes")
    back: Maybe<Telemetry> = decodeTelemetry(got[0])
    t.check(!back.isNull(), "and it decodes")
    t.check(back.value.uptimeMs == 123456 && back.value.heapBytes == 98765, "uptime and heap come back")
    t.check(back.value.tempCenti == -500 && back.value.rssiDbm == -60, "a negative temperature and signal come back")
    t.check(got[0].ver == 1 && got[0].kind == 3, "telemetry is framed as kind 3, version 1")
}

telemetryRefusesOtherFrames: (t: Suite) Void {
    other: Frame = decode(encode(1, 1, 0, "abcdefgh".bytes()).value).value
    t.check(decodeTelemetry(other).isNull(), "a status frame is not telemetry")
    short: Frame = decode(encode(3, 1, 0, "abcd".bytes()).value).value
    t.check(decodeTelemetry(short).isNull(), "telemetry of the wrong size is refused")
}

selftestReportIsReadAndAnAbsentSummaryFails: (t: Suite) Void {
    r: Report = readReport(@listOf("ok a", "FAIL b: read low", "ok c", "selftest 2/3"))
    t.check(r.passed == 2 && r.total == 3, "the summary's counts are read")
    t.check(r.failures.size() == 1 && !r.ok(), "a failed check makes the report not ok")
    t.check(readReport(@listOf("ok a", "selftest 2/2")).ok(), "a full pass is ok")
    t.check(!readReport(@listOf("FAIL a: low", "selftest 2/2")).ok(), "a FAIL line is not ok even under a full count")
    t.check(!readReport(@listOf("ok a")).ok(), "no summary line is not ok")
    t.check(!readReport(@listOf("ok a", "selftest 0/0")).ok(), "zero checks is not ok")
}

ina226ConvertsItsRegisters: (t: Suite) Void {
    t.check(busMillivolts(8000) == 10000.0, "8000 counts of bus voltage is 10000 mV")
    t.check(shuntMicrovolts(1000) == 2500.0, "1000 counts of shunt voltage is 2500 uV")
    t.check(shuntMicrovolts(65536 - 1000) == -2500.0, "a negative shunt voltage is two's complement")
    t.check(shuntMicrovolts(32768) == -81920.0, "the sign boundary: 32768 is the most negative count")
    t.check(currentMilliamps(2500.0, 10.0) == 250.0, "2500 uV across 10 mOhm is 250 mA")
    t.check(calibration(10.0, 100.0) == 5120, "the calibration register for 10 mOhm and 100 uA")
}

ds18b20ReadsTwosComplement: (t: Suite) Void {
    t.check(ds18b20Celsius(1360) == 85.0, "0x0550 is the power-on 85 C")
    t.check(ds18b20Celsius(65528) == -0.5, "0xFFF8 is minus half a degree")
    t.check(ds18b20Celsius(0) == 0.0, "zero is zero")
    t.check(ds18b20Celsius(32768) == -2048.0, "the sign boundary: 32768 is the most negative count")
}

ringKeepsTheNewestSamples: (t: Suite) Void {
    r: Ring { 3 }
    for v: Int64 in 1..6 {
        r.push(v)
    }
    t.check(r.count() == 3, "a ring of 3 holds 3")
    t.check(r.at(0) == 3 && r.at(2) == 5, "the window is the newest three, oldest first")
}

// Seeded so every run sees the same bytes: a linear congruential generator, 31 bits.
noiseNeverFramesAndAFrameAfterItAlwaysArrives: (t: Suite) Void {
    seed: Mutable<Int64> = 12345
    noise: Mutable<List<UInt8>> { }
    for i: Int32 in 0..4000 {
        seed = (seed * 1103515245 + 12345) & 0x7FFFFFFF
        noise.add(((seed >> 16) & 0xFF) as UInt8)
    }
    r: Receiver { }
    spurious: List<Frame> = receiveAll(r, noise)
    t.check(spurious.size() == 0, "random bytes complete no frame with a valid CRC")
    tail: List<UInt8> = encode(2, 1, 99, "fuzzok!!".bytes()).value
    got: List<Frame> = receiveAll(r, tail)
    t.check(got.size() == 1 && got[0].seq == 99, "a frame after the noise still arrives")
}

// Every other frame has a payload byte flipped: those are dropped, and the clean ones between them all arrive.
corruptedFramesAreDroppedAndTheCleanOnesArrive: (t: Suite) Void {
    seed: Mutable<Int64> = 777
    r: Receiver { }
    delivered: Mutable<Int32> = 0
    for round: Int32 in 0..300 {
        bytes: Mutable<List<UInt8>> = encode(1, 1, round, "abcdefgh".bytes()).value
        if round % 2 == 0 {
            seed = (seed * 1103515245 + 12345) & 0x7FFFFFFF
            at: Size = 12 + (seed % 8) as Size
            bytes.set(at, (bytes[at] ^ 0x5A) as UInt8)
        }
        delivered = delivered + (receiveAll(r, bytes).size() as Int32)
    }
    t.check(delivered == 150, "exactly the 150 clean frames arrive, the corrupt ones are dropped: got ${delivered}")
}

checkRefusesASecondMagicByteAndAnOversizedLength: (t: Suite) Void {
    good: List<UInt8> = encode(2, 1, 1, "abcdefgh".bytes()).value
    wrongSecond: Mutable<List<UInt8>> { }
    for b: UInt8 in good {
        wrongSecond.add(b)
    }
    wrongSecond.set(1, 88)
    t.check(check(wrongSecond) == BAD_MAGIC, "a wrong second magic byte is BAD_MAGIC")
    // A header claiming 1028 payload bytes, with 1000 bytes behind it: refused now, not waited for.
    huge: Mutable<List<UInt8>> { }
    for b: Int32 in @listOf(0x42, 0x57, 1, 1, 0, 0, 0, 0, 0x04, 0x04, 0, 0) {
        huge.add(b as UInt8)
    }
    for i: Int32 in 0..1000 {
        huge.add(0)
    }
    t.check(check(huge) == BAD_LENGTH, "a length past MAX_PAYLOAD is BAD_LENGTH, not a frame to wait for")
}

sequenceKeepsItsTwoBytes: (t: Suite) Void {
    got: Maybe<Frame> = decode(encode(1, 1, 300, "abcd".bytes()).value)
    t.check(got.value.seq == 300, "a sequence number past 255 keeps its high byte")
}

aFrameHalfAWindowAheadIsNotNewer: (t: Suite) Void {
    n: Newest { }
    t.check(n.accept(0), "the first frame is newest")
    t.check(!n.accept(32768), "exactly half the window ahead is not newer")
    t.check(n.accept(32767), "one short of half the window ahead is newer")
}

aReceiverRefusesAnOversizedHeaderAndTheFrameAfterItArrives: (t: Suite) Void {
    r: Receiver { }
    data: Mutable<List<UInt8>> { }
    for b: Int32 in @listOf(0x42, 0x57, 1, 1, 0, 0, 0, 0, 0x04, 0x04, 0, 0) {
        data.add(b as UInt8)
    }
    for b: UInt8 in encode(1, 1, 21, "wxyz".bytes()).value {
        data.add(b)
    }
    got: List<Frame> = receiveAll(r, data)
    t.check(got.size() == 1 && got[0].seq == 21, "an oversized header is skipped and the frame after it arrives")
}

// A B with no W behind it, then bytes that would read as a 1024-byte length if the B were a header: the frame behind
// them must still arrive, so the receiver must need both magic bytes before it waits for a length.
aReceiverNeedsBothMagicBytes: (t: Suite) Void {
    r: Receiver { }
    data: Mutable<List<UInt8>> { }
    for b: Int32 in @listOf(0x42, 0x58, 0, 0, 0, 0, 0, 0, 0x00, 0x04, 0, 0) {
        data.add(b as UInt8)
    }
    for b: UInt8 in encode(1, 1, 22, "wxyz".bytes()).value {
        data.add(b)
    }
    got: List<Frame> = receiveAll(r, data)
    t.check(got.size() == 1 && got[0].seq == 22, "a B without a W is noise, and the frame after it arrives")
}

telemetryRowsAreCells: (t: Suite) Void {
    row: List<Str> = telemetryRow("2026-11-01T12:00:00Z", Telemetry { 1500, 200000, 2510, -48 })
    t.check(row.size() == telemetryHeader().size(), "a row has a cell for each header column")
    t.checkStr(row.joinToString(","), "2026-11-01T12:00:00Z,1500,200000,2510,-48", "the cells, comma-separated")
}

fourFrames: () List<UInt8> {
    all: Mutable<List<UInt8>> { }
    for seq: Int32 in 1..5 {
        for x: UInt8 in encode(1, 1, seq, "abcd".bytes()).value {
            all.add(x)
        }
    }
    all
}

bridgeFeedAll: (br: Bridge, data: List<UInt8>) List<UInt8> {
    out: Mutable<List<UInt8>> { }
    for x: UInt8 in data {
        for y: UInt8 in br.feed(x) {
            out.add(y)
        }
    }
    out
}

seqsThrough: (bytes: List<UInt8>) Str {
    r: Receiver { }
    seqs: Mutable<List<Str>> { }
    for f: Frame in receiveAll(r, bytes) {
        seqs.add("${f.seq}")
    }
    seqs.joinToString(",")
}

bridgePassesFramesUnchanged: (t: Suite) Void {
    br: Bridge { mode = PASS, every = 1 }
    input: List<UInt8> = fourFrames()
    out: List<UInt8> = bridgeFeedAll(br, input)
    t.check(out.size() == input.size(), "a passing bridge forwards every byte")
    t.checkStr(seqsThrough(out), "1,2,3,4", "all four frames come through")
}

bridgeDropsEveryNthFrame: (t: Suite) Void {
    br: Bridge { mode = DROP, every = 2 }
    t.checkStr(seqsThrough(bridgeFeedAll(br, fourFrames())), "1,3", "every second frame is dropped")
    br3: Bridge { mode = DROP, every = 3 }
    t.checkStr(seqsThrough(bridgeFeedAll(br3, fourFrames())), "1,2,4", "every third frame is dropped")
}

bridgeCorruptsEveryNthFrame: (t: Suite) Void {
    br: Bridge { mode = CORRUPT, every = 2 }
    input: List<UInt8> = fourFrames()
    out: List<UInt8> = bridgeFeedAll(br, input)
    t.check(out.size() == input.size(), "a corrupting bridge keeps the stream the same length")
    t.checkStr(seqsThrough(out), "1,3", "the corrupted frames fail their CRC and do not come out as frames")
}

pub main: () Int32 {
    t: Suite { title = "esp32_test - the esp32 library (lines, debounce, command)" }
    linesAreCutAtTheNewline(t)
    aLongLineIsCut(t)
    aPressNeedsItsStreak(t)
    noiseNeverPresses(t)
    commandsAreSplit(t)
    crcMatchesTheStandardCheckValue(t)
    aFrameRoundTrips(t)
    aSeqWrapsInTwoBytes(t)
    aBadPayloadIsRefused(t)
    aFlippedByteFailsTheCrc(t)
    aMalformedFramesAreNamed(t)
    newestWinsAndLateFramesAreDropped(t)
    aFrameArrivesByteByByte(t)
    noiseBeforeAFrameIsSkipped(t)
    aCorruptFrameIsDroppedAndTheNextOneArrives(t)
    backToBackFramesAreBothEmitted(t)
    aBogusLengthDoesNotStallTheStream(t)
    telemetryRoundTrips(t)
    bridgePassesFramesUnchanged(t)
    bridgeDropsEveryNthFrame(t)
    bridgeCorruptsEveryNthFrame(t)
    telemetryRowsAreCells(t)
    telemetryRefusesOtherFrames(t)
    selftestReportIsReadAndAnAbsentSummaryFails(t)
    ina226ConvertsItsRegisters(t)
    ds18b20ReadsTwosComplement(t)
    ringKeepsTheNewestSamples(t)
    noiseNeverFramesAndAFrameAfterItAlwaysArrives(t)
    corruptedFramesAreDroppedAndTheCleanOnesArrive(t)
    aReceiverNeedsBothMagicBytes(t)
    aReceiverRefusesAnOversizedHeaderAndTheFrameAfterItArrives(t)
    aFrameHalfAWindowAheadIsNotNewer(t)
    sequenceKeepsItsTwoBytes(t)
    checkRefusesASecondMagicByteAndAnOversizedLength(t)
    t.finish()
}
