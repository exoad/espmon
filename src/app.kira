esp32.command.Command as Command
esp32.debounce.Debounce as Debounce
esp32.fw.board.button as button
esp32.fw.board.freeHeap as freeHeap
esp32.fw.board.led as led
esp32.fw.board.log as log
esp32.fw.board.millis as millis
esp32.fw.board.readByte as readByte
esp32.fw.board.sleep as sleep
esp32.fw.board.temperatureC as temperatureC
esp32.lines.LineBuffer as LineBuffer

// The smoke firmware: a serial shell and the BOOT button toggling the LED. main.cpp only forwards
// Arduino's setup and loop here.

LINE_CAP: Size = 80
POLL_MS: Int32 = 2
PRESS_STEPS: Int32 = 5

Shell: Mutable<Any> {
    buf: LineBuffer = LineBuffer { LINE_CAP }
    pad: Debounce = Debounce { PRESS_STEPS }
    lit: Mutable<Bool> = false
    pressed: Mutable<Bool> = false

    show: (value: Bool) Void {
        lit = value
        led(value)
    }

    run: (line: Str) Void {
        c: Command = Command { line }
        verb: Str = c.verb()
        if verb == "led" {
            if c.arg(0).isNull() {
                log("led ${lit ? "on" : "off"}")
            } else {
                show(c.arg(0).value == "on")
            }
        } else if verb == "temp" {
            log("temp ${temperatureC()} C")
        } else if verb == "heap" {
            log("heap ${freeHeap()} bytes")
        } else if verb == "uptime" {
            log("uptime ${millis()} ms")
        } else if verb == "button" {
            log("button ${pressed ? "down" : "up"}")
        } else if verb == "" {
        } else {
            log("commands: led [on|off], temp, heap, uptime, button")
        }
    }

    pub tick: () Void {
        b: Mutable<Maybe<UInt8>> = readByte()
        while !b.isNull() {
            line: Maybe<Str> = buf.push(b.value)
            if !line.isNull() {
                run(line.value)
            }
            b = readByte()
        }
        down: Bool = pad.step(button())
        if down && !pressed {
            show(!lit)
        }
        pressed = down
    }
}

SHELL: Shell = Shell { }

pub setup: () Void {
    log("esp32 smoke firmware ready")
}

pub loop: () Void {
    SHELL.tick()
    sleep(POLL_MS)
}
