esp32.command.Command as Command
esp32.debounce.Debounce as Debounce
esp32.fw.adc as adc
esp32.fw.chip as chip
esp32.fw.clock as clock
esp32.fw.gpio as gpio
esp32.fw.i2c as i2c
esp32.fw.i2c.I2c as I2c
esp32.fw.pwm as pwm
esp32.fw.uart as uart
esp32.fw.uart.Uart as Uart
esp32.fw.wifi as wifi
esp32.frame.encode as encode
esp32.frame.Frame as Frame
esp32.link.Receiver as Receiver
esp32.lines.LineBuffer as LineBuffer

// The smoke firmware: a serial shell, the BOOT button toggling the LED, and a selftest that
// exercises each esp32.fw module on the chip and prints ok or FAIL lines.

LINE_CAP: Size = 80
POLL_MS: UInt32 = 2
PRESS_STEPS: Int32 = 5
LED: Int32 = 2
BOOT: Int32 = 0
LOOPBACK_PIN: Int32 = 4
ADC_PIN: Int32 = 34
SDA: Int32 = 21
SCL: Int32 = 22

Shell: Mutable<Any> {
    pub console: Uart = uart.uart0()
    pub linkPort: Uart = uart.uart1()
    inbound: Receiver = Receiver { }
    sent: Mutable<Int32> = 0
    received: Mutable<Int32> = 0
    linkSeq: Mutable<Int32> = 0
    buf: LineBuffer = LineBuffer { LINE_CAP }
    pad: Debounce = Debounce { PRESS_STEPS }
    lit: Mutable<Bool> = false
    pressed: Mutable<Bool> = false
    passed: Mutable<Int32> = 0
    failed: Mutable<Int32> = 0

    show: (value: Bool) Void {
        lit = value
        gpio.write(LED, value)
    }

    check: (ok: Bool, name: Str, detail: Str) Void {
        if ok {
            passed += 1
            console.println("ok ${name}")
        } else {
            failed += 1
            console.println("FAIL ${name}: ${detail}")
        }
    }

    selftest: () Void {
        passed = 0
        failed = 0
        gpio.mode(LOOPBACK_PIN, gpio.OUTPUT)
        gpio.write(LOOPBACK_PIN, true)
        check(gpio.read(LOOPBACK_PIN), "gpio reads back a high output", "read low")
        gpio.write(LOOPBACK_PIN, false)
        check(!gpio.read(LOOPBACK_PIN), "gpio reads back a low output", "read high")
        gpio.toggle(LOOPBACK_PIN)
        check(gpio.read(LOOPBACK_PIN), "gpio toggles", "still low")

        t0: UInt32 = clock.millis()
        clock.delay(20)
        waited: UInt32 = clock.millis() - t0
        check(waited >= 19 && waited <= 40, "clock waits 20 ms", "waited ${waited} ms")
        u0: UInt32 = clock.micros()
        clock.delayMicros(500)
        spent: UInt32 = clock.micros() - u0
        check(spent >= 480 && spent <= 900, "clock waits 500 us", "waited ${spent} us")

        check(chip.model() == "ESP32-D0WD-V3", "chip model", chip.model())
        check(chip.cores() == 2, "chip has two cores", "${chip.cores()}")
        check(chip.cpuMhz() == 240, "chip runs at 240 MHz", "${chip.cpuMhz()}")
        check(chip.flashBytes() == 4194304, "chip has 4 MB of flash", "${chip.flashBytes()}")
        check(chip.freeHeap() > 100000 && chip.freeHeap() <= chip.heapBytes(), "heap is sane", "${chip.freeHeap()} of ${chip.heapBytes()}")
        check(chip.mac() != 0, "chip has a MAC", "zero")
        temp: Float32 = chip.temperatureC()
        check(temp > -20.0 && temp < 120.0, "chip temperature is plausible", "${temp}")
        check(chip.resetReason() > 0, "chip says why it reset", "${chip.resetReason()}")

        adc.resolution(12)
        raw: Int32 = adc.read(ADC_PIN)
        mv: Int32 = adc.millivolts(ADC_PIN)
        check(raw >= 0 && raw <= 4095, "adc reads within 12 bits", "${raw}")
        check(mv >= 0 && mv <= 3600, "adc millivolts are within the pin's range", "${mv}")

        check(pwm.attach(LED, 5000, 8), "pwm attaches", "refused")
        check(pwm.write(LED, 128), "pwm writes a duty", "refused")
        check(pwm.read(LED) == 128, "pwm reads the duty back", "${pwm.read(LED)}")
        check(pwm.detach(LED), "pwm detaches", "refused")
        show(false)

        bus: I2c = i2c.i2c0()
        check(bus.begin(SDA, SCL, 100000), "i2c starts", "refused")
        bus.timeoutMs(20)
        found: List<Int32> = bus.scan()
        check(found.size() <= 112, "i2c scan completes", "${found.size()}")
        console.println("i2c devices: ${found.size()}")
        check(!bus.probe(0x77) || found.contains(0x77), "i2c probe agrees with the scan", "disagree")
        bus.end()

        console.println("selftest ${passed}/${passed + failed}")
    }

    // Four bytes, little-endian.
    u32Bytes: (v: Int64) List<UInt8> {
        out: Mutable<List<UInt8>> = List<UInt8> { }
        for i: Int32 in 0..4 {
            out.add(((v >> (8 * i)) & 0xFF) as UInt8)
        }
        out
    }

    // Sends a status frame (kind 1): uptime and free heap, each a u32.
    sendStatus: () Void {
        body: Mutable<List<UInt8>> = List<UInt8> { }
        for b: UInt8 in u32Bytes(clock.millis() as Int64) {
            body.add(b)
        }
        for b: UInt8 in u32Bytes(chip.freeHeap()) {
            body.add(b)
        }
        frame: Maybe<List<UInt8>> = encode(1, 1, linkSeq, body)
        linkSeq = (linkSeq + 1) % 65536
        for b: UInt8 in frame.value {
            linkPort.write(b)
        }
        sent += 1
        console.println("link sent status seq ${linkSeq - 1}")
    }

    // Reads every byte waiting on the link, and acts on each whole frame: kind 2 sets the LED from its first byte.
    drainLink: () Void {
        b: Mutable<Maybe<UInt8>> = linkPort.read()
        while !b.isNull() {
            got: Maybe<Frame> = inbound.push(b.value)
            if !got.isNull() {
                received += 1
                console.println("link received kind ${got.value.kind} seq ${got.value.seq} bytes ${got.value.payload.size()}")
                if got.value.kind == 2 && got.value.payload.size() > 0 {
                    show(got.value.payload[0] == 1)
                }
            }
            b = linkPort.read()
        }
    }

    wifiCommand: (c: Command) Void {
        sub: Str = c.arg(0).isNull() ? "" : c.arg(0).value
        if sub == "scan" {
            found: Int32 = wifi.scan()
            console.println("wifi networks ${found}")
            for i: Int32 in 0..found {
                console.println("  ${wifi.networkRssiAt(i)} dBm ${wifi.networkAt(i)}")
            }
        } else if sub == "join" && !c.arg(1).isNull() {
            pass: Str = c.arg(2).isNull() ? "" : c.arg(2).value
            wifi.join(c.arg(1).value, pass)
            console.println("wifi joining ${c.arg(1).value}")
        } else if sub == "status" {
            console.println("wifi status ${wifi.status()} connected ${wifi.isConnected()} network ${wifi.linkNetwork()} address ${wifi.address()} rssi ${wifi.rssi()}")
        } else if sub == "leave" {
            wifi.leave()
            console.println("wifi left")
        } else {
            console.println("wifi: scan, join SSID [PASSWORD], status, leave")
        }
    }

    run: (line: Str) Void {
        c: Command = Command { line }
        verb: Str = c.verb()
        if verb == "led" {
            if c.arg(0).isNull() {
                console.println("led ${lit ? "on" : "off"}")
            } else {
                show(c.arg(0).value == "on")
            }
        } else if verb == "temp" {
            console.println("temp ${chip.temperatureC()} C")
        } else if verb == "heap" {
            console.println("heap ${chip.freeHeap()} bytes")
        } else if verb == "uptime" {
            console.println("uptime ${clock.millis()} ms")
        } else if verb == "button" {
            console.println("button ${pressed ? "down" : "up"}")
        } else if verb == "link" {
            sub: Str = c.arg(0).isNull() ? "" : c.arg(0).value
            if sub == "send" {
                sendStatus()
            } else {
                console.println("link sent ${sent} received ${received}")
            }
        } else if verb == "wifi" {
            wifiCommand(c)
        } else if verb == "selftest" {
            selftest()
        } else if verb == "" {
        } else {
            console.println("commands: led [on|off], temp, heap, uptime, button, selftest")
        }
    }

    pub tick: () Void {
        drainLink()
        b: Mutable<Maybe<UInt8>> = console.read()
        while !b.isNull() {
            line: Maybe<Str> = buf.push(b.value)
            if !line.isNull() {
                run(line.value)
            }
            b = console.read()
        }
        down: Bool = pad.step(!gpio.read(BOOT))
        if down && !pressed {
            show(!lit)
        }
        pressed = down
    }
}

SHELL: Mutable<Maybe<Shell>> = null

pub setup: () Void {
    shell: Shell = Shell { }
    shell.console.begin(115200)
    shell.linkPort.beginOn(115200, 16, 17)
    gpio.mode(LED, gpio.OUTPUT)
    gpio.mode(BOOT, gpio.INPUT_PULLUP)
    shell.console.println("esp32 smoke firmware ready")
    SHELL = shell
}

pub loop: () Void {
    if !SHELL.isNull() {
        SHELL.value.tick()
    }
    clock.delay(POLL_MS)
}
