// The ESP32 serial monitor's Kira, compiled to Python: espmon.kira becomes the espmon_kira.py beside it.
PROJECT: Project = Project { } with {
    name = "esp32.espmon"
    srcDir = "."
    target = "py"
    types = "strict"
    dependencies = @mapOf("kira_stdlib", "../../../RPLIDAR-C1/build/kira-toolchain/kira")
}
