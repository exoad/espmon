// The esp32 library: the Kira modules a host tool and the firmware share, imported as esp32.<module>.
PROJECT: Project = Project { } with {
    name = "esp32"
    srcDir = "src"
    target = "py"
    types = "strict"
    dependencies = @mapOf("kira_stdlib", "../../RPLIDAR-C1/build/kira-toolchain/kira")
}
