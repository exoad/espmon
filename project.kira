// The smoke firmware: the esp32 library's modules on a real board, built by PlatformIO.
PROJECT: Project = Project { } with {
    name = "smoke"
    srcDir = "src"
    target = "cpp"
    cpp = Cpp {
        layout = "beside",
        runtimeDir = "lib",
        lineDirectives = false,
        sourceExt = ".kira.cpp",
        headerOnly = @listOf("esp32.**")
    }
    types = "strict"
    dependencies = @mapOf("kira_stdlib", "vendor/kira/kira", "esp32", "esp32", "esp32.fw", "esp32fw")
}
