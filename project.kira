PROJECT: Project = Project { } with {
    name = "esp32.fw"
    srcDir = "src"
    target = "cpp"
    cpp = Cpp {
        layout = "beside",
        runtimeDir = "lib",
        lineDirectives = false,
        headerOnly = @listOf("esp32.fw.**"),
        namespaces = @mapOf("esp32.fw.board", "board", "esp32.fw.app", "app")
    }
    types = "strict"
    dependencies = @mapOf("kira_stdlib", "../RPLIDAR-C1/build/kira-toolchain/kira")
}
