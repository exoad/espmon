kira.args as args
kira.io as io
kira.os as os
kira.time as time
esp32.lines.LineBuffer as LineBuffer
esp32.link.Receiver as Receiver
esp32.frame.Frame as Frame
esp32.telemetry.decodeTelemetry as decodeTelemetry
esp32.telemetry.Telemetry as Telemetry
esp32.telemetry.telemetryRow as telemetryRow
esp32.telemetry.telemetryHeader as telemetryHeader

// espmon: reads the ESP32's serial port and prints each line with a UTC time. With --telemetry it reads the board's
// telemetry frames out of the same stream and prints each one, and skips the text. With --csv PATH it also appends
// each frame as a CSV row to PATH, under a header row, and implies --telemetry.

DEFAULT_PORT: Str = "COM10"
DEFAULT_BAUD: Int64 = 115200
READ_MS: Int64 = 500
CHUNK: Size = 256
LINE_CAP: Size = 512

pub main: () Int32 {
    spec: ArgSpec = argSpec("espmon", "Print the ESP32's serial output with UTC times.")
    spec.text("--port", DEFAULT_PORT, "the serial port")
    spec.whole("--baud", DEFAULT_BAUD, "the baud rate")
    spec.flag("--telemetry", "print the board's telemetry frames instead of its text")
    spec.text("--csv", "", "also append each telemetry frame to this CSV file")
    argv: Mutable<List<Str>> { }
    all: List<Str> = args()
    for i: Size in 1..all.size() {
        argv.add(all[i])
    }
    parsed: Parsed = spec.parse(argv)
    port: Serial {}
    if !port.open(parsed.textOf("--port").value, parsed.wholeOf("--baud").value as Int32) {
        eprint("espmon: ${lastError()}\n")
        1
    } else {
        stop: Atomic<Bool> { value = false }
        onSignal(SIGNAL_INT, stop)
        buf: Mutable<List<UInt8>> = @listOf()
        for i: Size in 0..CHUNK {
            buf.add(0)
        }
        lines: LineBuffer { LINE_CAP }
        frames: Receiver { }
        csvPath: Str = parsed.textOf("--csv").unwrapOr("")
        telemetry: Bool = parsed.isSet("--telemetry") || csvPath != ""
        csvFile: Maybe<FileOut> = csvPath == "" ? null : openAppend(csvPath)
        if csvPath != "" && csvFile.isNull() {
            eprint("espmon: cannot open ${csvPath}\n")
            stop.store(true)
        } else if csvPath != "" && csvFile.value.size() == 0 {
            csvFile.value.write(csvLine(telemetryHeader()).bytes())
        }
        while !stop.load() {
            n: Int64 = port.read(buf.from(0), READ_MS)
            if n < 0 {
                eprint("espmon: ${lastError()}\n")
                stop.store(true)
            } else {
                for i: Size in 0..(n as Size) {
                    if telemetry {
                        got: Maybe<Frame> = frames.push(buf.get(i))
                        if !got.isNull() && !decodeTelemetry(got.value).isNull() {
                            t: Telemetry = decodeTelemetry(got.value).value
                            stamp: Str = utcStamp(wallNowNs())
                            println("${stamp} uptime ${t.uptimeMs} ms heap ${t.heapBytes} B temp ${t.tempCenti} centi-C rssi ${t.rssiDbm} dBm")
                            if !csvFile.isNull() {
                                csvFile.value.write(csvLine(telemetryRow(stamp, t)).bytes())
                                csvFile.value.sync()
                            }
                        }
                    } else {
                        line: Maybe<Str> = lines.push(buf.get(i))
                        if !line.isNull() {
                            println("${utcStamp(wallNowNs())} ${line.value}")
                        }
                    }
                }
            }
        }
        port.close()
        if !csvFile.isNull() {
            csvFile.value.close()
        }
        csvPath != "" && csvFile.isNull() ? 1 : 0
    }
}
