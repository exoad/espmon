// A hardware UART: the USB console is uart0; uart1 and uart2 take any pins.

@_opaque @_extern(cpp = "HardwareSerial", header = "HardwareSerial.h") RawUart: Mutable<Any> {
    pub @_mutates @_extern(cpp = "begin") begin: (baud: UInt32) Void;
    pub @_mutates @_extern(cpp = "begin") beginOn: (baud: UInt32, config: UInt32, rx: Int8, tx: Int8) Void;
    pub @_mutates @_extern(cpp = "end") end: () Void;
    pub @_mutates @_extern(cpp = "print") print: (text: Str) Size;
    pub @_mutates @_extern(cpp = "println") println: (text: Str) Size;
    pub @_mutates @_extern(cpp = "write") write: (b: UInt8) Size;
    pub @_mutates @_extern(cpp = "read") read: () Int32;
    pub @_mutates @_extern(cpp = "available") available: () Int32;
    pub @_mutates @_extern(cpp = "flush") flush: () Void;
}

@_extern(cpp = "&Serial", header = "HardwareSerial.h") SERIAL0: RawUart;
@_extern(cpp = "&Serial1", header = "HardwareSerial.h") SERIAL1: RawUart;
@_extern(cpp = "&Serial2", header = "HardwareSerial.h") SERIAL2: RawUart;
@_extern(cpp = "SERIAL_8N1", header = "HardwareSerial.h") SERIAL_8N1: UInt32;

pub Uart: Mutable<Any> {
    raw: RawUart

    // Starts the port at baud, 8N1, on its default pins.
    pub begin: (baud: Int64) Void {
        raw.begin(baud as UInt32)
    }

    // Starts the port at baud, 8N1, on the given receive and transmit pins.
    pub beginOn: (baud: Int64, rx: Int32, tx: Int32) Void {
        raw.beginOn(baud as UInt32, SERIAL_8N1, rx as Int8, tx as Int8)
    }

    pub end: () Void {
        raw.end()
    }

    pub print: (text: Str) Void {
        raw.print(text)
    }

    pub println: (text: Str) Void {
        raw.println(text)
    }

    pub write: (b: UInt8) Void {
        raw.write(b)
    }

    pub writeAll: (data: List<UInt8>) Void {
        for i: Size in 0..data.size() {
            raw.write(data[i])
        }
    }

    // The bytes waiting to be read.
    pub available: () Int32 {
        raw.available()
    }

    // The next byte, none when nothing is waiting.
    pub read: () Maybe<UInt8> {
        b: Int32 = raw.read()
        b < 0 ? null : (b as UInt8)
    }

    // Waits until everything written has gone out.
    pub flush: () Void {
        raw.flush()
    }
}

pub uart0: () Uart {
    Uart { SERIAL0 }
}

pub uart1: () Uart {
    Uart { SERIAL1 }
}

pub uart2: () Uart {
    Uart { SERIAL2 }
}
